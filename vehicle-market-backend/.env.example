# ── App ──────────────────────────────────────────────
APP_NAME=Vehicle Market API
APP_VERSION=0.1.0
DEBUG=False

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vehicle_market

# ── Redis / Celery ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────
API_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
