# ── App ──────────────────────────────────────────────
APP_NAME=Vehicle Market API
APP_VERSION=0.1.0
DEBUG=False

# ── MongoDB ──────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=vehicle_market

# ── Redis / Celery ───────────────────────────────────
